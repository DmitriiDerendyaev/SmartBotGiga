# Пример локальной конфигурации. Скопируйте в .env и заполните.
# РЕАЛЬНЫЕ секреты хранятся в Infisical, не в Git!

# PostgreSQL
SMARTBOT_DB_PASSWORD=change-me

# Telegram (Phase 2) — токен выдаётся через Infisical, не коммитить
# SMARTBOT_TELEGRAM_BOT_TOKEN=

# GigaChat (Phase 4) — Authorization Key через Infisical, не коммитить
# SMARTBOT_GIGACHAT_AUTH_KEY=
# SMARTBOT_GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Образ приложения
SMARTBOT_IMAGE_TAG=latest
